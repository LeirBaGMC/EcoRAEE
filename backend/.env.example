# Copia este archivo como .env (en la carpeta backend). Valores de ejemplo y sinteticos.
# Opcion A: SQL Server Express con tu usuario de Windows (la mas simple)
ECORAEE_DB_URL=mssql+pyodbc://@localhost\SQLEXPRESS/ecoraee_cloud?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# Opcion B: con usuario y clave de SQL Server (borra la opcion A y usa esta)
# ECORAEE_DB_URL=mssql+pyodbc://ecoraee_app:TuClaveAqui@localhost\SQLEXPRESS/ecoraee_cloud?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
ECORAEE_CORS_ORIGINS=http://localhost:5173
ECORAEE_EVIDENCE_MAX_BYTES=10485760
ECORAEE_JWT_SECRET=CAMBIAR_por_texto_aleatorio_de_32_o_mas_caracteres
# Almacenamiento: 'local' para desarrollo o 's3' para AWS.
ECORAEE_STORAGE=local
ECORAEE_EVIDENCE_DIR=almacen_evidencias
# Solo necesario cuando ECORAEE_STORAGE=s3. EC2 debe usar un rol IAM, no claves.
# ECORAEE_S3_BUCKET=nombre-del-bucket-privado
# AWS_REGION=us-east-1
# ECORAEE_S3_KMS_KEY_ID=arn:aws:kms:region:cuenta:key/id
# Ajustes para el pool de SQLAlchemy/RDS.
ECORAEE_DB_POOL_SIZE=5
ECORAEE_DB_MAX_OVERFLOW=10
ECORAEE_DB_POOL_TIMEOUT=30
ECORAEE_DB_POOL_RECYCLE=1800
